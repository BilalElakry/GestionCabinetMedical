@{
    ViewData["Title"] = "Espace Secrétaire";
}

<style>
    .secretaire-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: transform 0.2s;
    }

        .secretaire-card:hover {
            transform: translateY(-5px);
        }
</style>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-user-nurse text-primary me-2"></i>Espace Secrétariat
            </h2>
            <p class="text-muted mb-0">
                <i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>
        <div class="btn-group">
            <a asp-controller="RendezVous" asp-action="Calendrier" class="btn btn-outline-primary">
                <i class="fas fa-calendar-alt me-1"></i>Calendrier
            </a>
            <a asp-controller="RendezVous" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Nouveau RDV
            </a>
            <a asp-controller="Patients" asp-action="Create" class="btn btn-success">
                <i class="fas fa-user-plus me-1"></i>Nouveau Patient
            </a>
        </div>
    </div>

    <!-- Statistiques principales -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card secretaire-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50">RDV Aujourd'hui</p>
                            <h3 class="mb-0">@ViewBag.RdvAujourdhui</h3>
                        </div>
                        <i class="fas fa-calendar-day fa-3x" style="opacity: 0.5;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card secretaire-card" style="background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: white;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50">En Attente</p>
                            <h3 class="mb-0">@ViewBag.RdvEnAttente</h3>
                        </div>
                        <i class="fas fa-hourglass-half fa-3x" style="opacity: 0.5;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card secretaire-card" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50">Confirmés</p>
                            <h3 class="mb-0">@ViewBag.RdvConfirmes</h3>
                        </div>
                        <i class="fas fa-check-circle fa-3x" style="opacity: 0.5;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card secretaire-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50">RDV ce Mois</p>
                            <h3 class="mb-0">@ViewBag.RdvCeMois</h3>
                        </div>
                        <i class="fas fa-calendar-check fa-3x" style="opacity: 0.5;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- RDV du jour -->
        <div class="col-lg-7 mb-4">
            <div class="card secretaire-card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-day me-2"></i>Rendez-vous d'Aujourd'hui
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RdvDuJour != null && ((IEnumerable<dynamic>)ViewBag.RdvDuJour).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Heure</th>
                                        <th>Patient</th>
                                        <th>Médecin</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rdv in (IEnumerable<dynamic>)ViewBag.RdvDuJour)
                                    {
                                        var statusClass = rdv.Statut == "Confirmé" ? "bg-success" :
                                        rdv.Statut == "En attente" ? "bg-warning text-dark" :
                                        rdv.Statut == "Annulé" ? "bg-danger" : "bg-info";
                                        <tr>
                                            <td>
                                                <strong class="text-primary">
                                                    <i class="fas fa-clock me-1"></i>@((DateTime)rdv.DateHeure).ToString("HH:mm")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong>@rdv.Patient.IdNavigation.Nom @rdv.Patient.IdNavigation.Prenom</strong>
                                                <br>
                                                <small class="text-muted">
                                                    <i class="fas fa-phone me-1"></i>@rdv.Patient.IdNavigation.Telephone
                                                </small>
                                            </td>
                                            <td>
                                                Dr. @rdv.Medecin.IdNavigation.Nom
                                                <br>
                                                <small class="text-muted">@rdv.Medecin.Specialite</small>
                                            </td>
                                            <td>
                                                <span class="badge @statusClass">@rdv.Statut</span>
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <a asp-controller="RendezVous" asp-action="Details" asp-route-id="@rdv.NumCom"
                                                       class="btn btn-sm btn-outline-primary" title="Détails">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (rdv.Statut == "En attente")
                                                    {
                                                        <button class="btn btn-sm btn-outline-success"
                                                                onclick="confirmerRdv(@rdv.NumCom)" title="Confirmer">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    }
                                                    <a asp-controller="RendezVous" asp-action="Edit" asp-route-id="@rdv.NumCom"
                                                       class="btn btn-sm btn-outline-warning" title="Modifier">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-day fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">Aucun rendez-vous aujourd'hui</h5>
                            <p class="text-muted">Journée tranquille ou calendrier vide</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RDV en attente de confirmation -->
        <div class="col-lg-5 mb-4">
            <div class="card secretaire-card h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-hourglass-half me-2"></i>À Confirmer
                    </h5>
                </div>
                <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                    @if (ViewBag.RdvEnAttenteList != null && ((IEnumerable<dynamic>)ViewBag.RdvEnAttenteList).Any())
                    {
                        <div class="list-group">
                            @foreach (var rdv in (IEnumerable<dynamic>)ViewBag.RdvEnAttenteList)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="mb-1">@((DateTime)rdv.DateHeure).ToString("dd/MM/yyyy")</h6>
                                            <p class="mb-1 text-primary">
                                                <i class="fas fa-clock me-1"></i>@((DateTime)rdv.DateHeure).ToString("HH:mm")
                                            </p>
                                        </div>
                                        <span class="badge bg-warning text-dark">En attente</span>
                                    </div>
                                    <p class="mb-1">
                                        <strong><i class="fas fa-user me-1"></i>@rdv.Patient.IdNavigation.Nom @rdv.Patient.IdNavigation.Prenom</strong>
                                    </p>
                                    <p class="mb-2 small text-muted">
                                        <i class="fas fa-user-md me-1"></i>Dr. @rdv.Medecin.IdNavigation.Nom - @rdv.Medecin.Specialite
                                    </p>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-success" onclick="confirmerRdv(@rdv.NumCom)">
                                            <i class="fas fa-check me-1"></i>Confirmer
                                        </button>
                                        <a asp-controller="RendezVous" asp-action="Details" asp-route-id="@rdv.NumCom"
                                           class="btn btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-double fa-3x text-success mb-3"></i>
                            <p class="text-muted">Tous les rendez-vous sont confirmés !</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Prochains RDV -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card secretaire-card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>Prochains Rendez-vous
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.ProchainsRdv != null && ((IEnumerable<dynamic>)ViewBag.ProchainsRdv).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date/Heure</th>
                                        <th>Patient</th>
                                        <th>Médecin</th>
                                        <th>Motif</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rdv in (IEnumerable<dynamic>)ViewBag.ProchainsRdv)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@((DateTime)rdv.DateHeure).ToString("dd/MM/yyyy")</strong>
                                                <br>
                                                <small class="text-primary">@((DateTime)rdv.DateHeure).ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                @rdv.Patient.IdNavigation.Nom @rdv.Patient.IdNavigation.Prenom
                                            </td>
                                            <td>
                                                Dr. @rdv.Medecin.IdNavigation.Nom
                                            </td>
                                            <td>@(rdv.Motif ?? "-")</td>
                                            <td>
                                                <span class="badge @(rdv.Statut == "Confirmé" ? "bg-success" : rdv.Statut == "En attente" ? "bg-warning text-dark" : "bg-secondary")">
                                                    @rdv.Statut
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-controller="RendezVous" asp-action="Details" asp-route-id="@rdv.NumCom"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="RendezVous" asp-action="Index" class="btn btn-outline-success">
                                <i class="fas fa-list me-1"></i>Voir tous les rendez-vous
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted">Aucun rendez-vous à venir</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Actions rapides -->
    <div class="row">
        <div class="col-12">
            <div class="card secretaire-card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Actions Rapides
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-2 mb-3">
                            <a asp-controller="RendezVous" asp-action="Create" class="text-decoration-none">
                                <div class="p-4 border rounded hover-effect">
                                    <i class="fas fa-calendar-plus fa-3x text-primary mb-2"></i>
                                    <p class="mb-0 font-weight-bold">Nouveau RDV</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a asp-controller="Patients" asp-action="Create" class="text-decoration-none">
                                <div class="p-4 border rounded hover-effect">
                                    <i class="fas fa-user-plus fa-3x text-success mb-2"></i>
                                    <p class="mb-0 font-weight-bold">Nouveau Patient</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a asp-controller="RendezVous" asp-action="Index" class="text-decoration-none">
                                <div class="p-4 border rounded hover-effect">
                                    <i class="fas fa-list fa-3x text-info mb-2"></i>
                                    <p class="mb-0 font-weight-bold">Tous les RDV</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a asp-controller="Patients" asp-action="Index" class="text-decoration-none">
                                <div class="p-4 border rounded hover-effect">
                                    <i class="fas fa-users fa-3x text-warning mb-2"></i>
                                    <p class="mb-0 font-weight-bold">Patients</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a asp-controller="RendezVous" asp-action="Calendrier" class="text-decoration-none">
                                <div class="p-4 border rounded hover-effect">
                                    <i class="fas fa-calendar fa-3x text-danger mb-2"></i>
                                    <p class="mb-0 font-weight-bold">Calendrier</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a asp-controller="Notifications" asp-action="Index" class="text-decoration-none">
                                <div class="p-4 border rounded hover-effect">
                                    <i class="fas fa-bell fa-3x text-secondary mb-2"></i>
                                    <p class="mb-0 font-weight-bold">Notifications</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmerRdv(id) {
            if (confirm('Confirmer ce rendez-vous ?')) {
                $.post('/RendezVous/ConfirmRdv', { id: id }, function(result) {
                    if (result.success) {
                        toastr.success('Rendez-vous confirmé avec succès!');
                        location.reload();
                    } else {
                        toastr.error('Erreur lors de la confirmation');
                    }
                });
            }
        }
    </script>
}

<style>
    .hover-effect:hover {
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        transition: all 0.3s;
        cursor: pointer;
        transform: translateY(-2px);
    }
</style>
